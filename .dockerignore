.vscode
.idea

# ---- Python ----
venv/
env/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# ---- Notebooks & checkpoints (dev-only, not needed at runtime) ----
*.ipynb
.ipynb_checkpoints/

